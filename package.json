{
  "name": "stone-marketplace",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:marketplace": "pnpm --filter @stone/marketplace dev",
    "dev:buyer": "pnpm --filter @stone/buyer dev",
    "dev:seller": "pnpm --filter @stone/seller dev",
    "dev:admin": "pnpm --filter @stone/admin dev",
    "dev:all": "turbo run dev --filter=\"./apps/*\"",
    "build": "turbo run build",
    "build:marketplace": "pnpm --filter @stone/marketplace build",
    "build:buyer": "pnpm --filter @stone/buyer build",
    "build:seller": "pnpm --filter @stone/seller build",
    "build:admin": "pnpm --filter @stone/admin build",
    "build:apps": "pnpm --filter @stone/marketplace --filter @stone/buyer --filter @stone/seller --filter @stone/admin build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @stone/web test:e2e",
    "db:check": "pnpm --filter @stone/database db:check",
    "db:migrate": "pnpm --filter @stone/database db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
