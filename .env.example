# =============================================================================
# StoneB2B (StonesDekho) — Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Gateway & API Configuration
# -----------------------------------------------------------------------------
# For Local Development (started via `supabase start`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>
#
# For Hosted Supabase:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<hosted-anon-key>
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# 2. Server-Only Secrets (NEVER expose to browser / client bundles)
# -----------------------------------------------------------------------------
# For Local Development:
# SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-supabase-status>
#
# For Hosted Supabase:
# SUPABASE_SERVICE_ROLE_KEY=<hosted-service-role-key>
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 3. Direct PostgreSQL Connection Strings
# -----------------------------------------------------------------------------
# For Local Development (Local Postgres on port 54322):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# For Hosted Supabase (Session pooler & direct port 5432):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# 4. Hostname & Subdomain Routing Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 5. Background Jobs & Worker Scheduled Secrets
# -----------------------------------------------------------------------------
# Used to authenticate GET/POST /api/cron/lead-outbox
CRON_SECRET=

